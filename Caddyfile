# ==============================================================================
# Caddy Configuration for Bandeh E-Commerce Platform
# ==============================================================================
# Pass the production domain using DOMAIN environment variable (e.g. DOMAIN=genabay.ir).

# Plain-HTTP site: serves ACME HTTP-01 challenge files WITHOUT redirecting
# (Let's Encrypt fetches the challenge over plain HTTP; a redirect to HTTPS
# would make Arvan fetch it from the origin over TLS, which fails while the
# origin cert is self-signed). Everything else redirects to HTTPS.
http://{$DOMAIN:localhost} {
    handle_path /.well-known/acme-challenge/* {
        root * /srv/acme-challenges
        file_server
    }
    handle {
        redir https://{host}{uri} permanent
    }
}

{$DOMAIN:localhost} {
    # Origin cert (2026-11-22): a real Let's Encrypt cert, issued on the
    # laptop (the server cannot reach Let's Encrypt itself — outbound
    # network dead). The files live in ./caddy-certs on the server.
    # Remove this line to go back to automatic HTTPS once the outbound
    # network recovers.
    tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem

    # Encode responses using modern compression algorithms
    encode zstd gzip

    # Reverse proxy application traffic to the FastAPI ASGI web service
    reverse_proxy web:80 {
        # Transparent proxy headers
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Health check to ensure traffic is only routed to responsive containers
        health_uri /health
        health_interval 10s
        health_timeout 3s
    }

    # Security headers for TLS enforcement and cross-site protections
    header {
        # Enable HTTP Strict Transport Security (HSTS)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Prevent MIME-sniffing
        X-Content-Type-Options "nosniff"
        # Prevent clickjacking
        X-Frame-Options "DENY"
        # Modern referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
        # Disable server signature identification
        -Server
    }

    # Structured JSON access logging for production auditing
    log {
        output stdout
        format json
    }
}
